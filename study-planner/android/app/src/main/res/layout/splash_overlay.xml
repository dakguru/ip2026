<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dakguru_splash_gradient"
    android:clickable="true"
    android:focusable="true"
    android:elevation="100dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Logo -->
        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/dakguru_logo_splash"
            android:scaleType="fitCenter"
            android:contentDescription="Dak Guru Logo" />

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Dak Guru"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Your LDCE Partner"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.1" />

    </LinearLayout>

    <!-- Loading spinner at bottom -->
    <ProgressBar
        android:id="@+id/splash_spinner"
        style="?android:attr/progressBarStyle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="80dp"
        android:indeterminate="true"
        android:indeterminateTint="#FFFFFF" />

</FrameLayout>
